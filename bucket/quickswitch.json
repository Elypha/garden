{
    "version": "1.9",
    "description": "Quickly switch file dialogs to folders open in your file manager or saved as favourites.",
    "homepage": "https://github.com/JoyHak/QuickSwitch",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/JoyHak/QuickSwitch/releases/download/1.9/QuickSwitch-1.9-x64.zip",
            "hash": "116d5c75f3d6813d5c6a3ae323c14cb76488445cd1ec4f8c73a31fa4115c7858"
        },
        "32bit": {
            "url": "https://github.com/JoyHak/QuickSwitch/releases/download/1.9/QuickSwitch-1.9-x32.zip",
            "hash": "1d98ebcc417f7b126310f3b13fd0d6e96f5abf2134eb0699cd4ee0d91f7566f7"
        }
    },
    "pre_install": "if (!(Test-Path \"$persist_dir\\QuickSwitch.ini\")) { Set-Content \"$dir\\QuickSwitch.ini\" '[Global]' -Encoding utf8 }",
    "post_uninstall": [
        "if ($cmd -ne 'uninstall') { return }",
        "$startupLink = Join-Path ([Environment]::GetFolderPath('Startup')) 'QuickSwitch.lnk'",
        "if (Test-Path -LiteralPath $startupLink -PathType Leaf) {",
        "    Remove-Item -LiteralPath $startupLink -Force -ErrorAction Stop",
        "}",
        "$tabsDir = Join-Path ([IO.Path]::GetTempPath()) 'TotalTabs'",
        "$tabsFile = Join-Path $tabsDir 'TotalTabs.tab'",
        "if (Test-Path -LiteralPath $tabsFile -PathType Leaf) { Remove-Item -LiteralPath $tabsFile -Force -ErrorAction Stop }",
        "if ((Test-Path -LiteralPath $tabsDir -PathType Container) -and !(Get-ChildItem -LiteralPath $tabsDir -Force)) { Remove-Item -LiteralPath $tabsDir -ErrorAction Stop }"
    ],
    "shortcuts": [
        [
            "QuickSwitch.exe",
            "QuickSwitch"
        ]
    ],
    "persist": [
        "QuickSwitch.ini",
        "Favorites",
        "Icons"
    ],
    "notes": [
        "QuickSwitch enables startup automatically on first launch. Change this in its settings if desired.",
        "Total Commander integration may add [EM_ScriptCommand_QuickSwitch_SaveAllTabs2] to its usercmd.ini. Remove that section manually after uninstalling if no longer needed.",
        "Changing the menu font affects Windows system menus. To reset it before uninstalling, clear the menu font field and set its size to 0 in QuickSwitch settings.",
        "Configuration, favourites and icons are retained on uninstall. Use 'scoop uninstall -p quickswitch' to remove persisted data. Custom external directories are managed by the user."
    ],
    "checkver": {
        "github": "https://github.com/JoyHak/QuickSwitch"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/JoyHak/QuickSwitch/releases/download/$version/QuickSwitch-$version-x64.zip"
            },
            "32bit": {
                "url": "https://github.com/JoyHak/QuickSwitch/releases/download/$version/QuickSwitch-$version-x32.zip"
            }
        }
    }
}
